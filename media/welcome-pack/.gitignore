# Rendered frames, stills and logs (rebuilt by make.sh)
out/*/frames/
out/*/keys/
out/*/render-*.log
out/make-*.log
out/chk*/
out/*/soundtrack.wav
# A local login session from the capture run: never commit
shots/*.json
!shots/manifest.json
shots/explore/
out/share.log
out/*.log
# The Reel's own copy of the screens: login sessions never committed
reel/shots/*.json
!reel/shots/manifest.json
# The Reel's working files (rebuilt by reel/make.sh)
out/reel/*.png
out/reel/*.jpg
out/reel/cues.json
out/reel/*.log
out/reel/review/
